# Copy to `frontend/.env.local` (gitignored). Next.js reads env files from this folder only,
# not from the repo-root `.env`. NEVER commit real keys.

# --- GACS Assistant (the floating help chat) ---
# Anthropic API key, used only by the server route src/app/api/chat/route.ts. It never reaches the
# browser. Without it the chat shows "The assistant is not set up yet."
ANTHROPIC_API_KEY=

# Hard cap on the total tokens the assistant may spend (input, cached input and output all count).
# Requests that could go past it are refused. "250000" and "250,000" both work.
# Leave empty for no app-level cap; anything unreadable is treated as 0 (assistant off).
# The running total is saved to CHAT_USAGE_FILE (default: the OS temp folder, gacs-chat-usage.json),
# so it survives dev-server restarts. Delete that file to reset the count.
# On serverless hosting each instance has its own file: set a spend limit in the Anthropic Console too.
CHAT_TOKEN_BUDGET=250000
# CHAT_USAGE_FILE=
