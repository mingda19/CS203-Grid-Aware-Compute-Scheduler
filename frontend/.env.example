# Copy to `frontend/.env.local` (gitignored). Next.js reads env files from this folder only,
# not from the repo-root `.env`. NEVER commit real keys.

# --- GACS Assistant (the floating help chat) ---
# Used only by the server route src/app/api/chat/route.ts; none of these reach the browser.
# Without ANTHROPIC_API_KEY or JWT_SECRET_KEY the chat shows "The assistant is not set up yet."
ANTHROPIC_API_KEY=
# The same value as the backend's JWT_SECRET_KEY. The route uses it to check the caller's token
# itself, so it never calls the backend. Server-only: never give it a NEXT_PUBLIC_ name.
JWT_SECRET_KEY=

# Token budget for the assistant (best effort, not a spend guarantee). Leave empty for none.
# The running total is saved to CHAT_USAGE_FILE (default: gacs-chat-usage.json in the OS temp
# folder); it holds token counts only, never chat text. Delete the file to reset the count.
CHAT_TOKEN_BUDGET=250000
# CHAT_USAGE_FILE=

# BEFORE PRODUCTION: also set a monthly spend limit on the Anthropic account that owns the key
# (Console > Limits). It is the only hard limit on spend.
