# Copy this file to `.env` in the repo root and fill in your own values.
#   cp .env.example .env
# `.env` is gitignored - NEVER commit real keys or passwords.
# The Python data scripts and the Spring Boot backend all read this one file.

# --- Data pulls (Python scripts) ---
# GridStatus.io API key: https://www.gridstatus.io
GRIDSTATUS_API_KEY=
# EIA API key: https://www.eia.gov/opendata/
EIA_API_KEY=

# --- Backend (Spring Boot) ---
PORT=8080
DATABASE_URL=
# Gmail API setup: docs/gmail-api-setup.md
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
JWT_SECRET_KEY=
COOKIE_SECURE=false
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=86400000
JWT_REMEMBER_ME_EXPIRATION_MS=1209600000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# TypeSafe API key for natural-language constraint parsing: https://docs.typesafe.ai
# Authenticates the TypeSafe account, not one model - the model is chosen per request
# (gacs.constraintparse.jev.model in application.properties), so this name does not change if the
# model does. Optional: with no key the rule-based parser is used and nothing is sent anywhere.
TYPESAFE_API_KEY=

