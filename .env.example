# Copy this file to `.env` in the repo root and fill in your own values.
#   cp .env.example .env
# `.env` is gitignored - NEVER commit real keys or passwords.
# The Python data scripts and the Spring Boot backend all read this one file.

# --- Data pulls (Python scripts) ---
# GridStatus.io API key: from your account settings at https://www.gridstatus.io
GRIDSTATUS_API_KEY=
# EIA API key: register at https://www.eia.gov/opendata/
EIA_API_KEY=

# --- Backend (Spring Boot; only used once the login feature is merged) ---
DATABASE_URL=
MAIL_USERNAME=
MAIL_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000
